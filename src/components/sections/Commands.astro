---
import { COMMANDS, type TerminalLine } from "../../data/site";
import Section from "../ui/Section.astro";
import Terminal from "../ui/Terminal.astro";

const NAME_WIDTH = Math.max(...COMMANDS.map(({ name }) => name.length)) + 2;

const tree: TerminalLine[] = [
	"devver",
	...COMMANDS.map(({ name, description }, index) => [
		{
			text: `${index === COMMANDS.length - 1 ? "└──" : "├──"} ${name.padEnd(NAME_WIDTH)}`,
		},
		{ text: description, tone: "dim" as const },
	]),
];
---

<Section id="terminal" title="Lives in your terminal" hash="c40e6b8">
	<p class="mb-5 max-w-[60ch] text-text-secondary">
		Scriptable commands when you know what you want. Run
		<code class="text-foreground">devver</code> alone to browse your deployments
		in the terminal UI.
	</p>
	<Terminal title="devver" lines={tree} />
	<p class="mt-3 text-muted-foreground">
		j/k/h/l move · o open · c copy · r rename · q quit
	</p>
</Section>
