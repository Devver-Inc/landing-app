---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a href={href} class="group whitespace-nowrap uppercase">
  <span aria-hidden="true" class="text-muted-foreground">[</span>
  <span class="px-1 group-hover:bg-primary group-hover:text-primary-foreground">{label}</span>
  <span aria-hidden="true" class="text-muted-foreground">]</span>
</a>
