---
interface Props {
  caption: string;
  headers: readonly string[];
  rows: readonly (readonly string[])[];
}

const { caption, headers, rows } = Astro.props;

// Text between backticks renders as inline code.
const segments = (cell: string) => cell.split("`");
---

<div tabindex="0" role="region" aria-label={caption} class="overflow-x-auto">
  <table class="w-full border-collapse text-left">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-border text-muted-foreground uppercase">
        {headers.map((header) => <th scope="col" class="py-2 pr-6 font-normal">{header}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([label, ...cells]) => (
          <tr class="border-b border-border">
            <th scope="row" class="py-2 pr-6 align-top font-normal whitespace-nowrap">{label}</th>
            {cells.map((cell) => (
              <td class="py-2 pr-6 align-top text-text-secondary">
                {segments(cell).map((part, index) =>
                  index % 2 ? <code class="text-foreground sm:whitespace-nowrap">{part}</code> : part,
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
