---
import { NAV } from "../../data/site";
import BracketLink from "../ui/BracketLink.astro";
import Logo from "../ui/Logo.astro";
---

<header class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-8">
  <Logo />
  <nav aria-label="Main">
    <ul class="flex flex-wrap gap-x-3">
      {
        NAV.map((link) => (
          <li>
            <BracketLink {...link} />
          </li>
        ))
      }
    </ul>
  </nav>
</header>
